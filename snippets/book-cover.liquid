{%- comment -%}
  Renders the book cover.
  Order: explicit image param, theme cover image, typographic fallback.
  Params: image (optional), width (optional, default 720), loading (optional)
{%- endcomment -%}
{%- liquid
  assign cover = image | default: settings.cover_image
  assign w = width | default: 720
  assign load = loading | default: 'lazy'
-%}
<div class="book" aria-label="{{ settings.book_title | escape }} by {{ settings.book_author | escape }}">
  <div class="book__spine" aria-hidden="true"></div>
  {%- if cover != blank -%}
    {{ cover | image_url: width: w | image_tag: class: 'book__img', loading: load, sizes: '(min-width: 990px) 420px, 70vw', widths: '360, 540, 720, 1080', alt: settings.book_title }}
  {%- else -%}
    <div class="book__face">
      <span class="book__strike" aria-hidden="true"></span>
      <p class="book__title">
        {%- assign words = settings.book_title | split: ' ' -%}
        {%- for word in words -%}
          {%- if forloop.last -%}<em>{{ word }}</em>{%- else -%}{{ word }} {% endif -%}
        {%- endfor -%}
      </p>
      <p class="book__subtitle">{{ settings.book_subtitle }}</p>
      <p class="book__author">{{ settings.book_author }}</p>
    </div>
  {%- endif -%}
</div>
