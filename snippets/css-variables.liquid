{{ 'geist-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'instrument-serif-latin-400-italic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- style -%}
  @font-face { font-family: 'Geist'; font-style: normal; font-weight: 100 900; font-display: swap; src: url({{ 'geist-latin-wght-normal.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Geist Mono'; font-style: normal; font-weight: 500; font-display: swap; src: url({{ 'geist-mono-latin-500-normal.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Instrument Serif'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif-latin-400-normal.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Instrument Serif'; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif-latin-400-italic.woff2' | asset_url }}) format('woff2'); }
  :root {
    --ink: {{ settings.color_ink }};
    --char: {{ settings.color_char }};
    --bone: {{ settings.color_bone }};
    --smoke: {{ settings.color_smoke }};
    --ember: {{ settings.color_ember }};
    --ember-deep: {{ settings.color_ember_deep }};
    --flare: {{ settings.color_flare }};
    --ash: {{ settings.color_ash }};
    --slate: {{ settings.color_slate }};
    --line: {{ settings.color_bone | color_modify: 'alpha', 0.12 }};
    --font-serif: 'Instrument Serif', Georgia, serif;
    --font-sans: 'Geist', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, SFMono-Regular, monospace;
  }
{%- endstyle -%}
