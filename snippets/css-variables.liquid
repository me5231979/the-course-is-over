{{ 'montserrat-italic-800-900.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'playfair-display-italic-400-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'source-serif-4-normal-400-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- style -%}
  @font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 500 800; font-display: swap; src: url({{ 'montserrat-normal-500-800.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Montserrat'; font-style: italic; font-weight: 800 900; font-display: swap; src: url({{ 'montserrat-italic-800-900.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 400 500; font-display: swap; src: url({{ 'playfair-display-italic-400-500.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Source Serif 4'; font-style: normal; font-weight: 400 600; font-display: swap; src: url({{ 'source-serif-4-normal-400-600.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Source Serif 4'; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'source-serif-4-italic-400.woff2' | asset_url }}) format('woff2'); }
  :root {
    /* Cover palette */
    --bg: {{ settings.color_background }};
    --paper: {{ settings.color_paper }};
    --card: {{ settings.color_card }};
    --text: {{ settings.color_text }};
    --muted: {{ settings.color_muted }};
    --accent: {{ settings.color_accent }};
    --accent-text: {{ settings.color_accent_text }};
    --dark: {{ settings.color_dark }};
    --on-dark: {{ settings.color_background }};
    --on-dark-muted: {{ settings.color_background | color_modify: 'alpha', 0.72 }};
    --line: {{ settings.color_text | color_modify: 'alpha', 0.14 }};
    --line-dark: {{ settings.color_background | color_modify: 'alpha', 0.16 }};

    /* Cover type: Montserrat Heavy Italic display, Playfair italic accents, Source Serif body */
    --font-display: 'Montserrat', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-italic: 'Playfair Display', Georgia, serif;
    --font-body: 'Source Serif 4', Georgia, 'Times New Roman', serif;

    --ease: cubic-bezier(.2, .7, .1, 1);
    --radius: 18px;
  }
{%- endstyle -%}
