{%- comment -%} Params: products {%- endcomment -%}
<ul class="grid">
  {%- for product in products -%}
    <li class="tile">
      <a href="{{ product.url }}">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 30vw, 50vw', alt: product.title }}
        {%- else -%}
          {% render 'book-cover' %}
        {%- endif -%}
        <span class="tile__title">{{ product.title }}</span>
        <span class="tile__price">{% render 'price', product: product %}</span>
      </a>
    </li>
  {%- else -%}
    <li class="note">{{ 'collections.empty' | t }}</li>
  {%- endfor -%}
</ul>
