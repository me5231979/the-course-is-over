{%- paginate blog.articles by 9 -%}
<section class="page">
  <div class="wrap">
    <h1 class="h1">{{ blog.title }}</h1>
    <ul class="posts">
      {%- for article in blog.articles -%}
        <li class="post">
          <p class="label">{{ article.published_at | date: format: 'date' }}</p>
          <h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <div class="note">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</div>
        </li>
      {%- else -%}
        <li class="note">{{ 'blogs.empty' | t }}</li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
