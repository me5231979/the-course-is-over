<section class="page cart">
  <div class="wrap wrap--narrow">
    <h1 class="h1">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="note">{{ 'cart.empty' | t }}</p>
      <a class="btn btn--ember" href="{{ routes.root_url }}#buy">{{ 'cart.continue' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart__form">
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart__item">
              <div class="cart__thumb">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}
                {%- endif -%}
              </div>
              <div class="cart__meta">
                <a href="{{ item.url }}" class="cart__name">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart__line-price">{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart__qty">
                <label class="visually-hidden" for="qty-{{ item.key }}">{{ 'cart.quantity' | t }}</label>
                <input id="qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                <a class="link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if settings.cart_notes -%}
          <label class="label" for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        {%- endif -%}

        <div class="cart__summary">
          <p class="cart__total"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="note">{{ 'cart.taxes' | t }}</p>
          <div class="cart__buttons">
            <button type="submit" name="update" class="btn btn--ghost">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--ember">{{ 'cart.checkout' | t }}</button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="cart__extra">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart" }
{% endschema %}
