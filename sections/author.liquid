<section class="author" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap author__inner">
    <div class="author__photo">
      {%- if section.settings.photo != blank -%}
        {{ section.settings.photo | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 420px, 90vw', alt: settings.book_author }}
      {%- else -%}
        <div class="author__placeholder" aria-hidden="true">
          {%- assign parts = settings.book_author | split: ' ' -%}
          {%- for part in parts -%}{{ part | slice: 0 }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="author__copy">
      <p class="label">{{ section.settings.label }}</p>
      <h2 class="h2">{{ settings.book_author }}</h2>
      <div class="author__bio">{{ section.settings.bio }}</div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About the author",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "author" },
    { "type": "image_picker", "id": "photo", "label": "Photo" },
    { "type": "text", "id": "label", "label": "Label", "default": "About the author" },
    {
      "type": "richtext",
      "id": "bio",
      "label": "Bio",
      "default": "<p>Matthew Estes has spent more than 20 years in organizational learning and leadership development, much of it in healthcare.</p><p>He started in sales after school. Like a lot of people in this field, he never knew L&amp;D was a career until he was in it. Today he builds working learning tools, coaches, and simulations instead of slide decks.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Book a talk" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "About the author" }]
}
{% endschema %}
