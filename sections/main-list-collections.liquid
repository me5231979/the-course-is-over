<section class="page">
  <div class="wrap">
    <h1 class="h1">{{ 'collections.all' | t }}</h1>
    <ul class="grid">
      {%- for collection in collections -%}
        <li class="tile">
          <a href="{{ collection.url }}">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- endif -%}
            <span class="tile__title">{{ collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
