<section class="page">
  <div class="wrap wrap--narrow">
    <h1 class="h1">{{ 'customer.activate' | t }}</h1>
    {%- form 'activate_customer_password', class: 'form' -%}
      {%- if form.errors -%}<div class="signup__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="label" for="ActPassword">{{ 'customer.password' | t }}</label>
      <input id="ActPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      <label class="label" for="ActConfirm">{{ 'customer.password_confirm' | t }}</label>
      <input id="ActConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn--ember" type="submit">{{ 'customer.activate' | t }}</button>
      <button class="btn btn--ghost" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Activate account" }
{% endschema %}
