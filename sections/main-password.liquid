<section class="hero hero--password">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="label label--ember">{{ settings.release_label }}</p>
      <h1 class="hero__title">
        {%- assign words = settings.book_title | split: ' ' -%}
        {%- for word in words -%}
          {%- if forloop.last -%}<em>{{ word }}</em>{%- else -%}{{ word }} {% endif -%}
        {%- endfor -%}
      </h1>
      <p class="hero__subtitle">{{ settings.book_subtitle }}</p>
      {%- if shop.password_message != blank -%}<p class="note">{{ shop.password_message }}</p>{%- endif -%}

      {%- form 'customer', class: 'signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,launch-list">
        {%- if form.posted_successfully? -%}
          <p class="signup__msg" role="status">You're on the list.</p>
        {%- else -%}
          <label class="visually-hidden" for="pw-email">Email</label>
          <input id="pw-email" type="email" name="contact[email]" placeholder="you@work.com" required>
          <button class="btn btn--ember" type="submit">Notify me</button>
        {%- endif -%}
      {%- endform -%}

      <details class="password__owner">
        <summary>Store owner? Enter password</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="signup__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="visually-hidden" for="Password">Password</label>
          <input id="Password" type="password" name="password" autocomplete="current-password">
          <button class="btn btn--ghost" type="submit">Enter</button>
        {%- endform -%}
      </details>
    </div>
    <div class="hero__cover">{% render 'book-cover', loading: 'eager' %}</div>
  </div>
</section>

{% schema %}
{ "name": "Password" }
{% endschema %}
