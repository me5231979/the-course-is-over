<section class="page">
  <div class="wrap wrap--narrow">
    <h1 class="h1">{{ 'customer.reset' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {%- if form.errors -%}<div class="signup__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="label" for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      <label class="label" for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label>
      <input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn--ember" type="submit">{{ 'customer.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Reset password" }
{% endschema %}
