[
  {
    "name": "theme_info",
    "theme_name": "The Course Is Over",
    "theme_version": "1.0.0",
    "theme_author": "Matthew Estes",
    "theme_documentation_url": "https://github.com/me5231979/the-course-is-over",
    "theme_support_url": "https://github.com/me5231979/the-course-is-over"
  },
  {
    "name": "Book",
    "settings": [
      {
        "type": "product",
        "id": "featured_book",
        "label": "Book product",
        "info": "The product the home page sells. Use one product with a Format option (Paperback, Hardcover, eBook, Audiobook)."
      },
      {
        "type": "image_picker",
        "id": "cover_image",
        "label": "Cover image",
        "info": "Used site-wide. Leave empty to show the typographic cover."
      },
      {
        "type": "text",
        "id": "book_title",
        "label": "Title",
        "default": "The Course Is Over"
      },
      {
        "type": "text",
        "id": "book_subtitle",
        "label": "Subtitle",
        "default": "A Bet on AI, Training, and How People Learn at Work"
      },
      {
        "type": "text",
        "id": "book_author",
        "label": "Author",
        "default": "Matthew Estes"
      },
      {
        "type": "text",
        "id": "release_label",
        "label": "Release status",
        "default": "Coming soon",
        "info": "Shown on the cover badge and buttons when the book isn't on sale yet."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "paragraph", "content": "Taken from the book cover: cream paper, near-black ink and one orange." },
      { "type": "color", "id": "color_background", "label": "Cream (page background)", "default": "#F5EEE6" },
      { "type": "color", "id": "color_paper", "label": "Paper (alternate sections)", "default": "#EFE6DB" },
      { "type": "color", "id": "color_card", "label": "Card", "default": "#FBF7F2" },
      { "type": "color", "id": "color_text", "label": "Ink (text)", "default": "#1C1B19" },
      { "type": "color", "id": "color_muted", "label": "Stone (secondary text)", "default": "#4A4741" },
      { "type": "color", "id": "color_accent", "label": "Orange (buttons, large type)", "default": "#FF5A1F" },
      { "type": "color", "id": "color_accent_text", "label": "Rust (small orange text on cream)", "default": "#B8360A" },
      { "type": "color", "id": "color_dark", "label": "Dark sections", "default": "#1C1B19" }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_podcast", "label": "Podcast" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px PNG" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_notes",
        "label": "Allow order notes",
        "default": true,
        "info": "Useful for signed-copy requests."
      }
    ]
  }
]
